{
  "name": "deictic",
  "version": "0.13.0",
  "description": "Point at an element in your running app and leave a task about it for your agent.",
  "keywords": [
    "annotations",
    "astro",
    "bun",
    "devtools",
    "inspector",
    "nextjs",
    "react",
    "recordings",
    "rrweb",
    "rspack",
    "screenshots",
    "tailwind",
    "turbopack",
    "vercel-board",
    "visual-editing",
    "vite",
    "voice",
    "webpack"
  ],
  "homepage": "https://github.com/gkurt/deictic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/deictic.git"
  },
  "bugs": {
    "url": "https://github.com/gkurt/deictic/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "workspaces": [
    "examples/*",
    "site"
  ],
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "API.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "deictic": "./dist/cli.js"
  },
