  "scripts": {
    "dev": "tsdown && bun run --cwd site dev",
    "lint": "oxlint && bun fmt --check",
    "fix": "oxlint --fix && bun fmt",
    "test": "bun test --conditions=deictic@dev",
    "checks": "bun run lint && bun check && bun run test",
    "build": "tsdown",
    "prepack": "tsdown --clean",
    "example": "tsdown && bun run --cwd examples/vite dev",
    "slop": "tsdown && bun run --cwd examples/slop dev",
    "prepare": "git config core.hooksPath .githooks || true",
    "staged": "bun scripts/staged.ts",
    "tegami": "bun scripts/tegami.mts"
  },
